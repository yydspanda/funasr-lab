{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yydspanda/funasr-lab/eval/candidate-lock.schema.json",
  "title": "funasr-lab sealed evaluation candidate lock",
  "description": "Restricted, canonical lock for one pre-registered ASR candidate and one sealed decode input. Cross-field hashes and command semantics are checked by eval/custodian_replay.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "state",
    "access_class",
    "dataset_id",
    "revision",
    "split",
    "data_sha256",
    "input_projection_sha256",
    "hypothesis_adapter_version",
    "record_identity_version",
    "record_input_sha256",
    "decode_item_count",
    "decode_item_ids_sha256",
    "source_manifest_decision",
    "candidate_registration_commit",
    "candidate_manifest_path",
    "candidate_manifest_sha256",
    "candidate",
    "candidate_freeze_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "asr-evaluation-candidate-lock"},
    "state": {"const": "frozen"},
    "access_class": {"const": "restricted"},
    "dataset_id": {"$ref": "#/$defs/shortString"},
    "revision": {"$ref": "#/$defs/shortString"},
    "split": {"const": "sealed-blind"},
    "data_sha256": {"$ref": "#/$defs/sha256"},
    "input_projection_sha256": {"$ref": "#/$defs/sha256"},
    "hypothesis_adapter_version": {"$ref": "#/$defs/hypothesisAdapter"},
    "record_identity_version": {"const": "eval-core-record-input-v1"},
    "record_input_sha256": {"$ref": "#/$defs/sha256"},
    "decode_item_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "decode_item_ids_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_decision": {"const": "planned"},
    "candidate_registration_commit": {"$ref": "#/$defs/gitCommit"},
    "candidate_manifest_path": {"$ref": "#/$defs/candidateManifestPath"},
    "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "candidate": {"$ref": "#/$defs/candidateFreeze"},
    "candidate_freeze_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "shortString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "hypothesisAdapter": {
      "enum": [
        "identity-v1",
        "sensevoice-control-tags-v1"
      ]
    },
    "candidateManifestPath": {
      "type": "string",
      "minLength": 43,
      "maxLength": 170,
      "pattern": "^experiments/manifests/EXP-[0-9]{8}-[0-9]{3}(-[a-z0-9-]+)?\\.json$"
    },
    "candidateFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "task_id",
        "hypothesis",
        "upstream_commit",
        "code_commit",
        "models",
        "config_sha256",
        "data_sha256",
        "eval_data_version",
        "normalizer_version",
        "hardware",
        "seed",
        "command"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "experiment_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^EXP-[0-9]{8}-[0-9]{3}(-[a-z0-9-]+)?$"
        },
        "task_id": {"const": "EVAL-01"},
        "hypothesis": {
          "type": "string",
          "minLength": 12,
          "maxLength": 16384
        },
        "upstream_commit": {"$ref": "#/$defs/gitCommit"},
        "code_commit": {"$ref": "#/$defs/gitCommit"},
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/modelComponent"}
        },
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "data_sha256": {"$ref": "#/$defs/sha256"},
        "eval_data_version": {"$ref": "#/$defs/shortString"},
        "normalizer_version": {"$ref": "#/$defs/shortString"},
        "hardware": {"$ref": "#/$defs/hardware"},
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "command": {"$ref": "#/$defs/command"}
      }
    },
    "modelComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identifier", "revision", "sha256"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "revision": {"$ref": "#/$defs/shortString"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id",
        "os",
        "cpu_model",
        "logical_cpu_count",
        "memory_bytes",
        "device",
        "accelerator"
      ],
      "properties": {
        "host_id": {"$ref": "#/$defs/shortString"},
        "os": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "cpu_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "logical_cpu_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1152921504606846976
        },
        "device": {"$ref": "#/$defs/shortString"},
        "accelerator": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_directory", "argv", "environment"],
      "properties": {
        "working_directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1024,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "environment": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
