{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yydspanda/funasr-lab/eval/core-report.schema.json",
  "title": "ASR evaluation core report",
  "description": "Byte-stable scoring evidence without runtime performance or local execution metadata. Exclusion originates only from a frozen record's evaluation_status: excluded items remain counted but do not enter scoring denominators, and predictions cannot dynamically exclude items. Arithmetic invariants are additionally enforced by eval.core_report.validate_core_report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "access_class",
    "provenance",
    "scoring",
    "configuration",
    "counts",
    "aggregate",
    "slices",
    "items"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "asr-evaluation-core"},
    "access_class": {"const": "restricted"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_sha256",
        "record_identity_version",
        "record_input_sha256",
        "prediction_input_sha256"
      ],
      "properties": {
        "data_sha256": {"$ref": "#/$defs/sha256"},
        "record_identity_version": {"const": "eval-core-record-input-v1"},
        "record_input_sha256": {"$ref": "#/$defs/sha256"},
        "prediction_input_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalizer_version",
        "mer_tokenizer_version",
        "alignment_version",
        "hypothesis_adapter_version",
        "rate_decimal_places"
      ],
      "properties": {
        "normalizer_version": {"const": "zh-content-v0.1"},
        "mer_tokenizer_version": {"const": "zh-en-mixed-v0.1"},
        "alignment_version": {
          "const": "levenshtein-diagonal-deletion-insertion-v1"
        },
        "hypothesis_adapter_version": {
          "enum": ["identity-v1", "sensevoice-control-tags-v1"]
        },
        "rate_decimal_places": {"const": 12}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_fields"],
      "properties": {
        "slice_fields": {
          "const": ["scenario_tags", "split"]
        }
      }
    },
    "counts": {"$ref": "#/$defs/counts"},
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "slices": {
      "type": "array",
      "items": {"$ref": "#/$defs/slice"}
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "substitutions",
        "deletions",
        "insertions",
        "errors",
        "reference_units",
        "rate",
        "rate_decimal"
      ],
      "properties": {
        "substitutions": {"type": "integer", "minimum": 0},
        "deletions": {"type": "integer", "minimum": 0},
        "insertions": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "reference_units": {"type": "integer", "minimum": 0},
        "rate": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/rate"}
          ]
        },
        "rate_decimal": {
          "description": "Deterministic half-up rendering of the exact rate with at most 12 fractional digits; null when reference_units is zero",
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
            }
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utterance_count",
        "scored_count",
        "ok_count",
        "failed_count",
        "empty_count",
        "excluded_count",
        "zero_reference_count"
      ],
      "properties": {
        "utterance_count": {"type": "integer", "minimum": 0},
        "scored_count": {"type": "integer", "minimum": 0},
        "ok_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "empty_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0},
        "zero_reference_count": {"type": "integer", "minimum": 0}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cer", "mer"],
      "properties": {
        "cer": {"$ref": "#/$defs/metric"},
        "mer": {"$ref": "#/$defs/metric"}
      }
    },
    "textView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "content", "display", "cer_units", "mer_units"],
      "properties": {
        "raw": {"type": "string"},
        "content": {"type": "string"},
        "display": {"type": "string"},
        "cer_units": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mer_units": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "sliceMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value"],
      "properties": {
        "dimension": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason_code",
        "slices",
        "reference",
        "hypothesis",
        "cer",
        "mer"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {
          "description": "excluded is a frozen-record decision, never a prediction decision",
          "enum": ["ok", "failed", "empty", "excluded"]
        },
        "reason_code": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/reasonCode"}
          ]
        },
        "slices": {
          "type": "array",
          "items": {"$ref": "#/$defs/sliceMembership"}
        },
        "reference": {"$ref": "#/$defs/textView"},
        "hypothesis": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/textView"}
          ]
        },
        "cer": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/metric"}
          ]
        },
        "mer": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/metric"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ok"}}},
          "then": {"properties": {"reason_code": {"type": "null"}}},
          "else": {"properties": {"reason_code": {"$ref": "#/$defs/reasonCode"}}}
        },
        {
          "if": {"properties": {"status": {"const": "excluded"}}},
          "then": {
            "properties": {
              "hypothesis": {"type": "null"},
              "cer": {"type": "null"},
              "mer": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "hypothesis": {"$ref": "#/$defs/textView"},
              "cer": {"$ref": "#/$defs/metric"},
              "mer": {"$ref": "#/$defs/metric"}
            }
          }
        }
      ]
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value", "item_ids", "counts", "aggregate"],
      "properties": {
        "dimension": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "item_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "counts": {"$ref": "#/$defs/counts"},
        "aggregate": {"$ref": "#/$defs/aggregate"}
      }
    }
  }
}
