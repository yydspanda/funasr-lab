{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yydspanda/funasr-lab/experiments/manifest.schema.json",
  "title": "funasr-lab experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "task_id",
    "hypothesis",
    "upstream_commit",
    "code_commit",
    "model",
    "model_revision",
    "config_sha256",
    "data_sha256",
    "eval_data_version",
    "normalizer_version",
    "hardware",
    "seed",
    "command",
    "metrics",
    "artifacts",
    "decision"
  ],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9]{8}-[0-9]{3}(-[a-z0-9-]+)?$"},
    "task_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
    "hypothesis": {"type": "string", "minLength": 1},
    "upstream_commit": {"type": "string", "minLength": 7},
    "code_commit": {"type": "string", "minLength": 7},
    "model": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "config_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "data_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "eval_data_version": {"type": "string", "minLength": 1},
    "normalizer_version": {"type": "string", "minLength": 1},
    "hardware": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "command": {"type": "string", "minLength": 1},
    "metrics": {
      "type": "object",
      "required": ["content_cer", "rtf_p50", "peak_rss_mb"],
      "properties": {
        "content_cer": {"type": "number", "minimum": 0},
        "mer": {"type": ["number", "null"], "minimum": 0},
        "rtf_p50": {"type": "number", "minimum": 0},
        "rtf_p95": {"type": ["number", "null"], "minimum": 0},
        "first_partial_ms": {"type": ["number", "null"], "minimum": 0},
        "finalization_ms": {"type": ["number", "null"], "minimum": 0},
        "partial_churn": {"type": ["number", "null"], "minimum": 0},
        "peak_rss_mb": {"type": "number", "minimum": 0}
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decision": {"enum": ["planned", "accept", "reject", "investigate"]}
  }
}
